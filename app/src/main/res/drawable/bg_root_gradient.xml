<?xml version="1.0" encoding="utf-8"?>
<!-- Clean neutral base with a soft accent glow fading in from the top edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_dark" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0"
                android:endColor="#00000000"
                android:gradientRadius="90%p"
                android:startColor="@color/bg_glow"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
